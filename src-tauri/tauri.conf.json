{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nib",
  "version": "0.4.0",
  "identifier": "com.nib.app",
  "build": {
    "frontendDist": ".."
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nib",
        "width": 520,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "../build/icon.ico"]
  }
}
