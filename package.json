{
  "name": "nib-island",
  "version": "0.3.2",
  "description": "A little dark island with a cat companion for Windows 11",
  "author": "Shahriar Zabid",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "node demo.js",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ical.js": "^2.1.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nib.app",
    "productName": "Nib",
    "artifactName": "Nib-Setup.exe",
    "files": [
      "**/*",
      "!dist/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "msz0",
      "repo": "nib"
    },
    "win": {
      "target": "nsis",
         "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}