{
  "name": "nib-island",
  "version": "0.4.0",
  "description": "A little dark island with a cat companion for Windows 11",
  "author": "m&m production",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "node demo.js",
    "dist": "node scripts/prepare-ocr.js && electron-builder",
    "release": "node scripts/prepare-ocr.js && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ical.js": "^2.1.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nib.app",
    "productName": "Nib",
    "artifactName": "Nib-Setup.exe",
    "files": [
      "**/*",
      "!dist/**",
      "!dist-test/**",
      "!resources/tesseract/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "msz0",
      "repo": "nib"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "extraResources": [
      {
        "from": "resources/tesseract",
        "to": "tesseract",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "ocr-clipboard.ps1",
        "to": "ocr-clipboard.ps1"
      }
    ]
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
